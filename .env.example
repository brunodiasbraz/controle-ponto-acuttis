# Aplicação
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MariaDB (10.3+). O banco precisa existir; as tabelas são criadas na inicialização.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ponto
DB_PASSWORD=
DB_NAME=ponto
# DB_POOL_SIZE=10

# HTTPS: em produção, defina NODE_ENV=production e APP_ORIGIN com a URL pública.
# NODE_ENV=production
APP_ORIGIN=
# COOKIE_SECURE=true também pode ativar cookies seguros fora de produção.
COOKIE_SECURE=false

# Usado apenas pelo comando de importação via terminal.
IMPORT_USERNAME=
