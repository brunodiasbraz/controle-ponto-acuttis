# Aplicação
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DB_PATH=data/ponto.sqlite

# HTTPS: em produção, defina NODE_ENV=production e APP_ORIGIN com a URL pública.
# NODE_ENV=production
APP_ORIGIN=
# COOKIE_SECURE=true também pode ativar cookies seguros fora de produção.
COOKIE_SECURE=false

# Usado apenas pelo comando de importação via terminal.
IMPORT_USERNAME=
